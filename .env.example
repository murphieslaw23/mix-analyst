# Mix Analyst Environment Configuration
# Copy this file to .env and adjust values as needed.

# App
DEBUG=false

# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/mixanalyst

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Storage
STORAGE_ROOT=/data/storage

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# API keys (comma-separated) guarding uploads, job dispatch, pipeline
# triggers, sync and mix edits. Empty = open single-user mode.
# Reads (archive, analysis, exports, audio, job status/SSE) stay open.
# API_KEYS=change-me-in-production

# Upload hygiene: stale unfinished sessions older than this are purged.
UPLOAD_EXPIRY_HOURS=24

# Optional: AcoustID API key enables real track identification.
# Without it, fingerprinting degrades to local hashes ("Unknown Track").
# ACOUSTID_API_KEY=
