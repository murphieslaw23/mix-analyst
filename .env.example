# Mix Analyst Environment Configuration
# Copy this file to .env and adjust values as needed.

# App
DEBUG=false

# Production HTTPS ingress. Set this to the canonical public DNS hostname
# before `docker compose up`; an HTTP LAN URL is not a release-capable PWA.
PUBLIC_ORIGIN=mix.example.com
AUTH_JWT_SECRET=replace-with-a-unique-32-character-or-longer-secret

# Optional Web Push. Generate one VAPID keypair, keep the private key server-only,
# and use a stable contact URI. A separate encryption key is recommended for
# subscription material; when omitted, AUTH_JWT_SECRET is used as the root key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:ops@example.com
PUSH_ENCRYPTION_KEY=

# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/mixanalyst

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Storage
STORAGE_ROOT=/data/storage

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
